TZ=America/Los_Angeles
DATA_FILE=./data/movie-nights.json
DISCORD_CLIENT_ID=your_application_id
DISCORD_TOKEN=your_bot_token
# Recommended while developing; guild commands update immediately.
DISCORD_GUILD_ID=your_server_id
MOVIE_NIGHTS_CHANNEL=movie-nights
TMDB_API_TOKEN=your_tmdb_api_read_access_token

# Optional OpenAI-compatible assistant. Mention the bot in a server channel to use it.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=your_api_key
OPENAI_MODEL=gpt-4o-mini
AI_MAX_INPUT_CHARACTERS=500
AI_MAX_OUTPUT_CHARACTERS=1600
AI_MAX_OUTPUT_TOKENS=400
AI_USER_RATE_LIMIT=5
AI_GUILD_RATE_LIMIT=30
AI_RATE_LIMIT_WINDOW_MS=300000
AI_TIMEOUT_MS=30000

# Runtime health and recovery. The bot exits after staying disconnected this long,
# allowing Docker's restart policy to recover it.
HEALTH_PORT=3000
BOT_HEARTBEAT_MS=300000
DISCORD_UNREADY_EXIT_MS=300000
LOG_LEVEL=info
